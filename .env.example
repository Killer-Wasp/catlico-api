# Copy to .env and fill in. Values here are safe defaults / placeholders.
# Empty vars are ignored (env_ignore_empty=True), so unset = use code default.
#
# This file is a LOCAL-DEV starter, not an exhaustive list. Every variable and
# its default is documented in docs/configuration.md; production setup (TLS,
# migrations, secret backup/rotation, scaling) is in docs/deployment.md.

# --- General ---------------------------------------------------------------
ENVIRONMENT=local
# Which JSON seed profile to load on local startup (a directory under
# app/core/seed_data/). "demo" = rich showcase, "dev" = minimal, "none" = skip.
# Only applied when ENVIRONMENT=local.
SEED_PROFILE=demo
FRONTEND_HOST=http://localhost:3000
# Comma-separated list of allowed CORS origins (in addition to FRONTEND_HOST).
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Mail (password reset delivery) ----------------------------------------
# `make dev` starts a Mailpit catcher: SMTP on :1025, web UI on http://localhost:8025.
# With these set, reset emails are trapped by Mailpit (nothing is really sent).
# Leave SMTP_HOST empty to disable delivery entirely (tokens are still created).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@catlico.local

# --- Database --------------------------------------------------------------
# Postgres is required. Start one with `docker compose up -d db`.
# Set POSTGRES_SERVER + POSTGRES_USER (+ the rest), or set DATABASE_URL directly
# to override everything. Startup fails fast if neither is configured.
# DATABASE_URL=postgresql+asyncpg://catlico:catlico@localhost:5432/catlico
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=catlico
POSTGRES_PASSWORD=catlico
POSTGRES_DB=catlico
# Echo SQL to the logger (local debugging only; never in production).
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=11520

# Default admin seeded on first run.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme

# Fernet key for encrypting connector secrets at rest. Required at startup.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=changeme

# --- Blob storage ----------------------------------------------------------
# local | s3 | gcs | az | abfs
STORAGE_PROTOCOL=local
# Directory for `local`; bucket (optionally bucket/prefix) for object stores.
STORAGE_ROOT=./var/blobs
MAX_UPLOAD_BYTES=104857600
# S3 / SeaweedFS knobs (used when STORAGE_PROTOCOL=s3).
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Plugin runner engine ---------------------------------------------------
# Single shared secret configured identically here and on every runner. It is
# the whole trust boundary: runners authenticate internal calls with
# `Authorization: Bearer <secret>` + `X-Runner-Id`, and the API HMAC-signs
# event/install pushes back to the runner with this same secret. Runners
# self-register on startup — no enrollment token to mint.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PLUGIN_RUNNER_SHARED_SECRET=changeme

# Auth cookies are Secure (HTTPS-only) by default. Local dev serves plain http,
# so browsers would drop the refresh cookie without this override.
COOKIE_SECURE=false
